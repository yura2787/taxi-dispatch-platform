# Inputs of the OSRM routing graph. infra/osrm/prepare.sh rebuilds the graph whenever
# any of these values (or the OSRM image tag in docker-compose.yml) changes.
# Updating the map is a deliberate change: bump the snapshot and its MD5 in one commit.

# Geofabrik yearly snapshot of Ukraine (2026-01-01). Unlike "-latest", dated snapshots
# never change and are kept forever, so every machine and CI builds the same graph.
OSM_SOURCE_URL=https://download.geofabrik.de/europe/ukraine-260101.osm.pbf

# Published next to the file (<url>.md5); a mismatch means a broken or replaced download.
OSM_SOURCE_MD5=4a0ec0389769145450b5093eaeb9fc1b

# min_lon,min_lat,max_lon,max_lat: Chernivtsi plus ~5 km around the service area, so
# routes near the edge can still use roads just outside the city.
OSM_BBOX=25.732,48.175,26.148,48.405

# Lua profile shipped in the OSRM image (/opt/<profile>.lua).
OSRM_PROFILE=car
